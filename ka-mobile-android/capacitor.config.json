{
  "appId": "com.vitalka.ka",
  "appName": "KA",
  "webDir": "www",
  "android": {
    "allowMixedContent": true,
    "loggingBehavior": "debug",
    "webContentsDebuggingEnabled": true,
    "minWebViewVersion": 100,
    "buildOptions": {
      "keystorePath": "release.keystore",
      "keystoreAlias": "ka-release"
    }
  },
  "ios": {
    "scheme": "KA",
    "contentInset": "automatic",
    "scrollEnabled": true,
    "limitsNavigationsToAppBoundDomains": false,
    "preferredContentMode": "mobile",
    "allowsLinkPreview": false
  },
  "server": {
    "androidScheme": "http",
    "cleartext": true,
    "iosScheme": "capacitor",
    "url": "http://10.0.2.2:8765"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#07070f",
      "showSpinner": false,
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "dark",
      "backgroundColor": "#07070f",
      "overlaysWebView": true
    },
    "Keyboard": {
      "resize": "body",
      "style": "dark",
      "resizeOnFullScreen": true
    },
    "CapacitorHttp": {
      "enabled": true
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_ka",
      "iconColor": "#8b83ff",
      "sound": "beep.wav"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "BackgroundTask": {
      "taskName": "ka-background-sync"
    },
    "Network": {
      "enable": true
    },
    "Device": {
      "enable": true
    },
    "App": {
      "enable": true
    },
    "Haptics": {
      "enable": true
    },
    "FilePicker": {
      "enable": true
    },
    "Camera": {
      "enable": true
    },
    "SpeechRecognition": {
      "enable": true
    }
  }
}