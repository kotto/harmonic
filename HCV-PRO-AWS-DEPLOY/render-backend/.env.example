# HCV PRO Backend - Variables d'Environnement

# Flask Configuration
HCV_PRO_SECRET=your-secret-key-here-change-in-production

# API Configuration
HCV_PRO_API_KEY_REQUIRED=true
HCV_PRO_RATE_LIMIT=100

# Server Configuration
PORT=5000
FLASK_ENV=production
FLASK_DEBUG=false

# Logging
LOG_LEVEL=INFO

# CORS Configuration
CORS_ORIGINS=*

# Database (optionnel)
DATABASE_URL=

# Redis (optionnel pour le caching)
REDIS_URL=
