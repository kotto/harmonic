{
  "version": 2,
  "builds": [
    {
      "src": "server/hcv_pro_server.py",
      "use": "@vercel/python"
    },
    {
      "src": "web/templates/*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/hcv_pro_server.py"
    },
    {
      "src": "/(.*)",
      "dest": "web/templates/$1"
    }
  ],
  "env": {
    "OPENBLAS_NUM_THREADS": "1",
    "MKL_NUM_THREADS": "1"
  }
}
