<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black">

    <!-- Loading / status overlay -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Progress indicator -->
        <ProgressBar
            android:id="@+id/progress_decomp"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/hcs_accent"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- Decompression status message -->
        <TextView
            android:id="@+id/tv_decomp_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chargement 8K..."
            android:textColor="@color/hcs_accent"
            android:textSize="16sp"
            android:gravity="center"
            android:padding="16dp"
            android:visibility="gone" />

        <!-- Full-resolution image -->
        <ImageView
            android:id="@+id/iv_full_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Bottom info bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#CC000000"
        android:padding="10dp">

        <TextView
            android:id="@+id/tv_player_resolution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/hcs_text_secondary"
            android:textSize="11sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_player_preset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/hcs_text_hint"
            android:textSize="11sp"
            android:gravity="center" />
    </LinearLayout>

</LinearLayout>
