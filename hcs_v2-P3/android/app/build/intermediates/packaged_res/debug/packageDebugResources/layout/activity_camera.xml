<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Camera Preview fills the screen -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/controls_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom controls overlay -->
    <LinearLayout
        android:id="@+id/controls_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#CC000000"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Preset info -->
        <TextView
            android:id="@+id/tv_preset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preset: Social 8K"
            android:textColor="@color/hcs_accent"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Main buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <!-- Flip camera -->
            <Button
                android:id="@+id/btn_flip"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="FLIP"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/hcs_surface"
                android:layout_marginEnd="6dp" />

            <!-- Photo button (center, larger) -->
            <Button
                android:id="@+id/btn_photo"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="2"
                android:text="PHOTO 8K"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/hcs_button_primary"
                android:layout_marginEnd="6dp" />

            <!-- Video button -->
            <Button
                android:id="@+id/btn_video"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1.5"
                android:text="VIDEO 8K"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/hcs_button_secondary" />
        </LinearLayout>

        <!-- Preset cycle -->
        <Button
            android:id="@+id/btn_preset"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Changer preset compression"
            android:textSize="12sp"
            android:textColor="@color/hcs_text_secondary"
            android:backgroundTint="@color/hcs_secondary"
            android:layout_marginBottom="4dp" />

        <!-- Status text -->
        <TextView
            android:id="@+id/tv_camera_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Camera HCS 8K prete"
            android:textColor="@color/hcs_success"
            android:textSize="11sp"
            android:gravity="center" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
