<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.HCSHarmonic" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/hcs_primary</item>
        <item name="colorPrimaryVariant">@color/hcs_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/hcs_secondary</item>
        <item name="colorSecondaryVariant">@color/hcs_secondary_dark</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/hcs_primary_dark</item>
        <item name="android:windowBackground">@color/hcs_background</item>
        <item name="android:textColor">@color/hcs_text_primary</item>
        <item name="android:textColorSecondary">@color/hcs_text_secondary</item>
    </style>

    <style name="Theme.HCSHarmonic.NoActionBar" parent="Theme.HCSHarmonic">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="HCSButton.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/hcs_button_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HCSButton.Secondary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/hcs_button_secondary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HCSButton.Accent" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/hcs_button_accent</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HCSText.Header" parent="Widget.MaterialComponents.TextView">
        <item name="android:textColor">@color/hcs_accent</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="HCSText.Subtitle" parent="Widget.MaterialComponents.TextView">
        <item name="android:textColor">@color/hcs_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="HCSText.Info" parent="Widget.MaterialComponents.TextView">
        <item name="android:textColor">@color/hcs_text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="HCSText.Status" parent="Widget.MaterialComponents.TextView">
        <item name="android:textColor">@color/hcs_success</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
