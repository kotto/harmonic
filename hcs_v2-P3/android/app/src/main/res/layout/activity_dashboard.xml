<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hcs_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tableau de Bord HCS"
            android:textColor="@color/hcs_accent"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Big savings number -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/hcs_card"
            android:padding="20dp"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_space_saved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 B liberes"
                android:textColor="@color/hcs_success"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_saved_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0% economise"
                android:textColor="@color/hcs_text_secondary"
                android:textSize="16sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Stats grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- Total media -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@color/hcs_surface"
                android:padding="12dp"
                android:gravity="center"
                android:layout_marginEnd="6dp">
                <TextView
                    android:id="@+id/tv_total_items"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/hcs_accent"
                    android:textSize="28sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total medias"
                    android:textColor="@color/hcs_text_hint"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Avg ratio -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@color/hcs_surface"
                android:padding="12dp"
                android:gravity="center"
                android:layout_marginStart="6dp">
                <TextView
                    android:id="@+id/tv_avg_ratio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="x0.0"
                    android:textColor="@color/hcs_info"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Compression moyenne"
                    android:textColor="@color/hcs_text_hint"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/hcs_surface"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Details"
                android:textColor="@color/hcs_accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_images_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 photos"
                android:textColor="@color/hcs_text_primary"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_videos_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 videos"
                android:textColor="@color/hcs_text_primary"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_original_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 B original"
                android:textColor="@color/hcs_text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_compressed_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 B stocke"
                android:textColor="@color/hcs_success"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Presets info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/hcs_surface"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Presets de compression"
                android:textColor="@color/hcs_accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_preset_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/hcs_text_secondary"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.4"
                android:fontFamily="monospace" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
