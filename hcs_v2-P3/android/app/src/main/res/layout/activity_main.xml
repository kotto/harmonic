<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hcs_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HCS Bundle"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/hcs_accent"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pack de Services Media 8K"
            android:textSize="14sp"
            android:textColor="@color/hcs_text_secondary"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Status bar -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Initialisation..."
            android:textColor="@color/hcs_success"
            android:textSize="12sp"
            android:gravity="center"
            android:background="@color/hcs_surface"
            android:padding="8dp"
            android:layout_marginBottom="16dp" />

        <!-- Stats card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/hcs_card"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Statistiques d'espace"
                android:textColor="@color/hcs_accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aucun media HCS pour l'instant"
                android:textColor="@color/hcs_text_primary"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.4" />
        </LinearLayout>

        <!-- Camera 8K button (main action) -->
        <Button
            android:id="@+id/btn_camera"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="CAMERA 8K"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/hcs_button_primary"
            android:layout_marginBottom="12dp" />

        <!-- Gallery button -->
        <Button
            android:id="@+id/btn_gallery"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="GALERIE (Vignettes HCS)"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/hcs_button_secondary"
            android:layout_marginBottom="12dp" />

        <!-- Dashboard button -->
        <Button
            android:id="@+id/btn_dashboard"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="TABLEAU DE BORD"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/hcs_button_accent"
            android:layout_marginBottom="20dp" />

        <!-- Info box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/hcs_surface"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Comment ca fonctionne:"
                android:textColor="@color/hcs_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/hcs_text_secondary"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.5" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
