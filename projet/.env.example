# Variables d'environnement Vercel — NE PAS COMMITTER les valeurs réelles
# Configurer via : vercel env add <NOM>

# Secret JWT (min 32 chars, générer avec : openssl rand -hex 32)
JWT_SECRET=

# Credentials opérateur (stockés côté serveur uniquement)
HCV_ADMIN_USER=
HCV_ADMIN_PASS=

# Origine autorisée (ex: https://hcv-studio.vercel.app)
ALLOWED_ORIGIN=

# Optionnel : clé API interne pour les webhooks
HCV_API_KEY=
