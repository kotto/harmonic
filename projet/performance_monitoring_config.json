{
  "metrics": {
    "latency": {
      "measurement": "response_time_ms",
      "threshold_warning": 3000,
      "threshold_critical": 5000
    },
    "throughput": {
      "measurement": "requests_per_second",
      "target": 4,
      "minimum": 1
    },
    "error_rate": {
      "measurement": "error_percentage",
      "threshold_warning": 1.0,
      "threshold_critical": 5.0
    },
    "determinism": {
      "measurement": "response_id_matches",
      "target": 100.0,
      "minimum": 100.0
    }
  },
  "alerting": {
    "email_alerts": [
      "alain.kotto@harmonica.ai",
      "devops@harmonica.ai"
    ],
    "slack_webhook": "https://hooks.slack.com/services/...",
    "sms_alerts": [
      "+33612345678"
    ]
  },
  "dashboard": {
    "refresh_interval": 30,
    "retention_days": 90,
    "export_format": [
      "json",
      "csv"
    ]
  }
}