{
  "project": "KA Hybrid - Interface Universelle Harmonique + DeepSeek",
  "version": "1.0.0",
  "description": "Pipeline complet : Hologramme ABC -> Base Vectorielle -> API DeepSeek contrainte -> Verification deterministe",

  "server": {
    "host": "0.0.0.0",
    "port": 8420,
    "cors_origins": ["*"]
  },

  "deepseek": {
    "mode": "api",
    "mode_comment": "api = API DeepSeek cloud, local = instance locale (a venir)",
    "model": "deepseek-chat",
    "base_url": "https://api.deepseek.com",
    "timeout_seconds": 60,
    "max_tokens_default": 500,
    "temperature_default": 0.3
  },

  "hologram": {
    "size": 1024,
    "patch_size": 64,
    "stride": 32,
    "abc_neighbors": 16,
    "abc_order": 0.6180339887498949,
    "abc_order_comment": "alpha* = 1/phi, ordre fractionnaire optimal"
  },

  "retrieval": {
    "patches_per_query": 30,
    "min_confidence": 0.5,
    "max_facts_context": 4000,
    "max_facts_display": 40
  },

  "verification": {
    "enabled": true,
    "strict_mode": false,
    "min_trace_ratio": 0.5,
    "min_trace_ratio_comment": "Ratio minimum de phrases tracables pour accepter une reponse"
  },

  "styles": {
    "general": {
      "description": "Reponse claire et precise",
      "max_tokens": 500,
      "temperature": 0.3
    },
    "concise": {
      "description": "Reponse courte, 2-3 phrases maximum",
      "max_tokens": 150,
      "temperature": 0.2
    },
    "creative": {
      "description": "Style elegant et poetique, tout en restant factuel",
      "max_tokens": 600,
      "temperature": 0.5
    },
    "technical": {
      "description": "Style technique et detaille",
      "max_tokens": 800,
      "temperature": 0.2
    }
  }
}