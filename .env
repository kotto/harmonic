# Configuration du Proxy Harmonique AWS
# ======================================

# Mode de generation: "backend" (appel API AWS) ou "harmonic" (moteur local)
GENERATION_MODE=backend

# Backend AWS (decommentez et configurez pour utiliser l'API AWS)
# BACKEND_BASE_URL=http://votre-instance:8080/v1
# BACKEND_MODEL=deepseek-qwen-hybrid
# BACKEND_API_KEY=sk-b419b59685414f98858318b77a19a47d
# Credentials AWS (pour acces S3 et services)
AWS_ACCESS_KEY_ID=AKIAUX3GRWKTZEPOJOFI
AWS_SECRET_ACCESS_KEY=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
AWS_DEFAULT_REGION=us-east-1
AWS_IAM_USER=harmonic-ai-user

# Buckets S3 disponibles
S3_BUCKET_KNOWLEDGE=harmonic-ai-knowledge-base
S3_BUCKET_DEEPSEEK=deepseek-models-326095712935

# Configuration du serveur
PORT=8080
HOST=0.0.0.0

# Mode determine
DETERMINISTIC_LOCK=true
VERIFIED_MODE_DEFAULT=false
ARENA_MODE_DEFAULT=false
ARENA_TEMPERATURE_DEFAULT=0.2

# Services harmoniques
AUDIO_SERVICE_URL=http://localhost:9017
VIDEO_SERVICE_URL=http://localhost:9018
LM_ARENA_SERVICE_URL=http://localhost:8000

# ======================================
# Bridge Harmonique ↔ DeepSeek-Qwen GGUF
# ======================================
# Chemin du modele GGUF sur le disque H:
GGUF_MODEL_PATH=H:\TELECHARGEMENT-18-20AOUT\Qwen3.5-9B-DeepSeek-V4-Flash-BF16.gguf
# Parametres d'inference
GGUF_N_CTX=4096
GGUF_N_THREADS=8
GGUF_N_GPU_LAYERS=0
GGUF_TEMPERATURE=0.7
GGUF_TOP_P=0.9
GGUF_TOP_K=40
# Parametres harmoniques
N_LECTEURS=8
N_REP_LECTURE=30
CONTEXTE_TOKENS_TOP=30
# Cache
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=512
  
# === DeepSeek-R1 API (Fallback LLM cloud) ===  
DEEPSEEK_API_KEY=sk-b419b59685414f98858318b77a19a47d 
