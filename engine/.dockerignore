# ──────────────────────────────────────────────
# .dockerignore — KA Server Docker build
# ──────────────────────────────────────────────

# Git
.git/
.gitignore

# Environnement local
.env
.env.*
*.log
*.pid

# Caches & artefacts
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
dist/
build/
*.egg

# Données (montées en volume)
data/saas_wave/
data/compress_history.json

# Modèles lourds (téléchargés au runtime)
models/
huggingface_cache/
torch_cache/
piper_voices/

# Tests
ka_server/tests/
ka_server/tools/

# Archives & build mobile
ka-mobile-android/
vital-ka/backend/
vital-ka/apps/
vital-ka/core/js/*.map

# IDE & OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Node
node_modules/
*.tgz