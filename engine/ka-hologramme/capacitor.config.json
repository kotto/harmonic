{
  "appId": "com.kahologramme.app",
  "appName": "KA Hologramme",
  "webDir": "www",
  "android": {
    "webContentsDebuggingEnabled": true
  },
  "ios": {
    "contentInset": "automatic",
    "scrollEnabled": true
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0e0e1a",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "light",
      "backgroundColor": "#0e0e1a"
    }
  }
}