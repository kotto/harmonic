  "s": "Asphyxie néonatale (Helping Babies Breathe)",
  "r": "conduite",
  "o": "GOLDEN MINUTE. 1. Sécher/stimuler. 2. Positionner la tête (sniffing position). 3. Désobstruction si besoin. 4. Ventilation au ballon-masque (40-60 insufflations/min) si apnée ou FC<100. 5. Réévaluer après 1 minute de ventilation efficace. Si FC<60 → masser (3:1).",
  "sec": "MERE_ENFANT"
 },
 {
  "s": "Asphyxie néonatale (Helping Babies Breathe)",
  "r": "traitement_ventilation",
  "o": "Ballon auto-gonflable néonatal. Air ambiant (pas d'O2 systématique). Fréquence 40-60/min.",
  "sec": "MERE_ENFANT"
 },
 {
  "s": "Asphyxie néonatale (Helping Babies Breathe)",
  "r": "traitement_massage_cardiaque",
  "o": "Si FC<60 après 1min ventilation. Technique des 2 pouces, 1/3 inférieur sternum, 3 compressions pour 1 ventilation.",
  "sec": "MERE_ENFANT"
 },
 {
