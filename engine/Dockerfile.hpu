COPY conscious_engine.py .
COPY conscious_creator.py .
COPY conscious_critic.py .
COPY conscious_intelligence.py .
COPY semantic_wave_embedding.py .
COPY apprentissage_v2.py .
COPY apprentissage_par_repétition.py .
COPY validation_coeff_quantiques.py .
COPY verification_coherence.py .
COPY verification_valeurs.py .
COPY verif_xeb_harmonique.py .
COPY constante_physiques_thu.py .
COPY generation_physique_quantique.py .
COPY verif_hamiltonien_tour.py .
COPY generation_tableau_periodique.py .
COPY calcul_masses_elements.py .
COPY depot_e3_tstar.py .
