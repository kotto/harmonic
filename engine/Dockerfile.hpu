COPY unification_qm_rg.py .
COPY fractalite_oyibo_thu.py .
COPY laplacien_fractionnaire.py .
COPY fock_fractionnaire.py .
COPY fermions_spineurs.py .
COPY r3_quantification_spin2.py .
COPY exploration_secteur_n2.py .
COPY exploration_force_em.py .
COPY exploration_masse_paquets_ondes.py .
COPY exploration_masse_potentiel.py .
COPY exploration_piste6_frft.py .
COPY exploration_piste5_entropie.py .
COPY elements_119_plus.py .
COPY index.html .
COPY THEORIE_HARMONIQUE_UNIVERSELLE.md .
COPY TABLEAU_PERIODIQUE_PARTICULES_THU.md .
COPY THEOREME_T6_MODULO7.md .

# Installer les dépendances
RUN pip install --no-cache-dir numpy scipy mpmath fastapi uvicorn

# Créer les répertoires de données
RUN mkdir -p /data/memory /data/holograms /data/benchmarks

# Port de l'API
EXPOSE 9100

# Santé
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD python -c "from hpu_v2_complet import HPU_V2; h=HPU_V2(); h.etat()" || exit 1

# Lancement
CMD ["uvicorn", "--host", "0.0.0.0", "--port", "9100", "--app-dir", "/app"]