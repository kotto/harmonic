{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KA Knowledge Wiki — Schéma de fichier",
  "description": "Validation d'un fichier de connaissance KA (format OKF-like).",
  "type": "object",
  "required": ["id", "domain", "title", "facts"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Identifiant unique du concept (slug, sans espace)"
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "description": "Domaine de connaissance (physique, astronomie, ...)"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Titre lisible du concept"
    },
    "type": {
      "type": "string",
      "enum": ["concept", "entity", "fact"],
      "default": "concept",
      "description": "Nature du fichier"
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "description": "Faits (triplets sujet | relation | objet)",
      "items": {
        "type": "object",
        "required": ["sujet", "relation", "objet"],
        "properties": {
          "sujet":   { "type": "string", "minLength": 1 },
          "relation": { "type": "string", "minLength": 1 },
          "objet":   { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
