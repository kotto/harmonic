{
  "nom": "Module Paludisme — KA Care",
  "version": "1.0",
  "source": "OMS Guidelines 2024",
  
  "pathologies": {
    "Paludisme_simple": {
      "symptomes": ["fièvre_cyclique", "frissons", "sueurs", "maux_de_tête", "nausées", "fatigue_intense", "douleurs_musculaires", "perte_appétit"],
      "gravite": "ÉLEVÉE",
      "urgence": true,
      "conduite": "Test goutte épaisse + TDR. Si confirmé : ACT (artéméther-luméfantrine) 3 jours. Paracétamol pour fièvre.",
      "delai_consultation": "24h",
      "traitement": {
        "premiere_ligne": "Artéméther-Luméfantrine (AL) 20/120 mg, 2×/jour, 3 jours",
        "alternative": "Artésunate-Amodiaquine (ASAQ) si AL indisponible",
        "contre_indications": "Pas d'aspirine ni ibuprofène (risque hémorragique)",
        "suivi": "Contrôle parasitémie à J3 et J28"
      }
    },
    
    "Paludisme_grave": {
      "symptomes": ["fièvre_élevée", "frissons_intenses", "confusion", "convulsions", "respiration_rapide", "prostration", "ictère", "urines_foncées", "anémie_sévère", "chute_tension"],
      "gravite": "URGENCE_VITALE",
      "urgence": true,
      "conduite": "TRANSFERT URGENT HÔPITAL. Artésunate IV immédiat. Réanimation.",
      "delai_consultation": "IMMÉDIAT",
      "traitement": {
        "premiere_ligne": "Artésunate IV 2.4 mg/kg à H0, H12, H24, puis toutes les 24h",
        "relais_oral": "ACT dès que le patient peut avaler (minimum 3j de traitement IV)",
        "complications": "Surveiller : hypoglycémie, IRA, œdème pulmonaire, coagulation"
      }
    },
    
    "Paludisme_femme_enceinte": {
      "symptomes": ["fièvre", "frissons", "fatigue_intense", "maux_de_tête", "nausées_accentuées", "douleurs_abdominales", "pâleur"],
      "gravite": "URGENCE_VITALE",
      "urgence": true,
      "conduite": "Hospitalisation systématique. Quinine + Clindamycine (1er trimestre) ou ACT (2-3e trimestre).",
      "delai_consultation": "IMMÉDIAT",
      "traitement": {
        "trimestre_1": "Quinine IV + Clindamycine 7 jours",
        "trimestre_2_3": "Artéméther-Luméfantrine (AL) ou Artésunate-Amodiaquine",
        "prevention": "TPI-SP (Sulfadoxine-Pyriméthamine) à chaque consultation prénatale"
      }
    },
    
    "Paludisme_enfant": {
      "symptomes": ["fièvre_élevée", "frissons", "vomissements", "refus_alimentation", "convulsions", "geignement", "respiration_rapide", "hypotonie"],
      "gravite": "URGENCE_VITALE",
      "urgence": true,
      "conduite": "Hospitalisation si < 5 ans ou signes de gravité. ACT pédiatrique. Surveillance rapprochée.",
      "delai_consultation": "IMMÉDIAT",
      "traitement": {
        "moins_5kg": "Artésunate suppositoire + transfert hospitalier",
        "5_15kg": "AL 20/120 mg pédiatrique, dose selon poids",
        "plus_15kg": "AL adulte, dose selon poids"
      }
    }
  },
  
  "diagnostic_differentiel": {
    "description": "Scores de similarité pour distinguer le paludisme des pathologies proches",
    "regles": [
      {"si": "fièvre_cyclique + frissons + sueurs", "evoque": "Paludisme (>90%)"},
      {"si": "fièvre_élevée + éruption_cutanée + douleurs_articulaires", "evoque": "Dengue plutôt que Paludisme"},
      {"si": "fièvre + toux + expectorations", "evoque": "Pneumonie ou Typhoïde"},
      {"si": "fièvre + ictère + urines_foncées", "evoque": "Paludisme grave ou Hépatite"},
      {"si": "fièvre_cyclique SANS frissons", "evoque": "Rechercher autre cause (VIH, TB, lymphome)"}
    ]
  },
  
  "zones_endemiques": {
    "afrique_subsaharienne": {"risque": "TRÈS ÉLEVÉ", "espece": "P. falciparum (90%)", "saison": "Toute l'année, pic en saison des pluies"},
    "asie_sud_est": {"risque": "MODÉRÉ", "espece": "P. vivax (50%), P. falciparum (50%)", "saison": "Saison des pluies"},
    "amazonie": {"risque": "MODÉRÉ", "espece": "P. vivax (70%), P. falciparum (30%)", "saison": "Toute l'année"},
    "importe": {"risque": "FAIBLE mais VIGILANCE", "espece": "Toutes espèces", "saison": "Retour de voyage zone endémique"}
  },
  
  "signes_gravite_oms": [
    "Neuropaludisme (score de Glasgow < 11)",
    "Prostration (impossibilité de s'asseoir ou de boire)",
    "Convulsions répétées (> 2 en 24h)",
    "Détresse respiratoire (FR > 30/min adulte)",
    "Ictère clinique + parasitémie > 100 000/µL",
    "Hémoglobinurie (urines foncées 'porto')",
    "Anémie sévère (Hb < 5 g/dL)",
    "Hypoglycémie (< 2.2 mmol/L)",
    "Acidose métabolique (bicarbonates < 15 mmol/L)",
    "Hyperparasitémie (> 10% GR parasités)"
  ],
  
  "prevention": {
    "chimioprophylaxie": {
      "voyageurs": "Atovaquone-Proguanil (Malarone) ou Doxycycline ou Méfloquine",
      "femmes_enceintes": "TPI-SP (Sulfadoxine-Pyriméthamine) à chaque CPN",
      "enfants": "Chimioprévention saisonnière (CPS) en zone sahélienne"
    },
    "lutte_vectorielle": [
      "Moustiquaires imprégnées d'insecticide (MILD)",
      "Pulvérisation intradomiciliaire (PID)",
      "Assainissement (suppression des gîtes larvaires)",
      "Répulsifs cutanés (DEET, IR3535)"
    ],
    "vaccination": "RTS,S/AS01 (Mosquirix) — 4 doses chez l'enfant de 5-17 mois en zone endémique"
  }
}
