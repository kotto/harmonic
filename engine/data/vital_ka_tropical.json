{
  "module": "Maladies Tropicales — KA Care",
  "version": "1.0",
  "source": "OMS Guidelines 2024",
  "pathologies": {
    "Dengue": {
      "symptomes": ["fièvre_élevée", "maux_de_tête_intenses", "douleurs_rétro_orbitaires", "douleurs_articulaires", "douleurs_musculaires", "éruption_cutanée", "nausées", "fatigue", "douleur_abdominale"],
      "gravite": "ÉLEVÉE",
      "urgence": true,
      "conduite": "Paracétamol UNIQUEMENT (pas d'AINS ni aspirine). Hydratation abondante. Surveillance plaquettes. Hospitalisation si signes d'alarme.",
      "delai_consultation": "24-48h",
      "traitement": {
        "symptomatique": "Paracétamol 1g ×3/jour max",
        "contre_indications_absolues": "Aspirine, Ibuprofène, kétoprofène, diclofénac (risque hémorragique)",
        "hydratation": "SRO ou IV selon sévérité",
        "surveillance": "Plaquettes, hématocrite, signes de fuite capillaire"
      },
      "signes_alarme": ["douleur_abdominale_intense", "vomissements_persistants", "saignements_muqueuses", "léthargie", "hépatomégalie", "augmentation_hématocrite"]
    },
    
    "Dengue_sévère": {
      "symptomes": ["fièvre_élevée", "choc", "saignements", "détresse_respiratoire", "douleur_abdominale_intense", "vomissements_persistants", "léthargie", "hépatomégalie"],
      "gravite": "URGENCE_VITALE",
      "urgence": true,
      "conduite": "HOSPITALISATION URGENTE. Réanimation hydrique. Surveillance continue. Transfusion si nécessaire.",
      "delai_consultation": "IMMÉDIAT"
    },
    
    "Chikungunya": {
      "symptomes": ["fièvre_brutale", "douleurs_articulaires_intenses", "polyarthralgie", "douleurs_musculaires", "maux_de_tête", "éruption_cutanée", "fatigue", "raideur_articulaire"],
      "gravite": "MODÉRÉE",
      "urgence": false,
      "conduite": "Paracétamol + AINS (si dengue exclue). Repos. Hydratation. Kinésithérapie si arthralgies persistantes.",
      "delai_consultation": "1-2 semaines si douleurs persistent",
      "particularite": "Arthralgies peuvent durer des mois (70% des cas). Signe distinctif : douleurs articulaires BILATÉRALES et SYMÉTRIQUES."
    },
    
    "Fièvre_typhoïde": {
      "symptomes": ["fièvre_progressive", "maux_de_tête", "douleurs_abdominales", "constipation_ou_diarrhée", "bradycardie_relative", "splénomégalie", "taches_roses", "abattement"],
      "gravite": "ÉLEVÉE",
      "urgence": true,
      "conduite": "Hémoculture + coproculture. Antibiotiques : Ceftriaxone IV ou Ciprofloxacine (si sensible).",
      "delai_consultation": "48h",
      "traitement": {
        "premiere_ligne": "Ceftriaxone IV 2g/jour 7-14 jours",
        "alternative": "Azithromycine 1g/jour 7 jours si souche multirésistante",
        "contre_indications": "Vérifier sensibilité aux fluoroquinolones (résistances fréquentes en Asie)"
      }
    },
    
    "Fièvre_jaune": {
      "symptomes": ["fièvre_brutale", "frissons", "maux_de_tête", "douleurs_musculaires", "nausées", "ictère", "hémorragies", "oligurie", "bradycardie"],
      "gravite": "URGENCE_VITALE",
      "urgence": true,
      "conduite": "Hospitalisation. Pas de traitement spécifique. Soins de support. Vaccination préventive.",
      "delai_consultation": "IMMÉDIAT",
      "vaccination": "Vaccin vivant atténué (Stamaril) — dose unique, protection à vie. Obligatoire en zone endémique."
    },
    
    "Zika": {
      "symptomes": ["fièvre_modérée", "éruption_cutanée", "conjonctivite", "douleurs_articulaires", "maux_de_tête", "myalgie", "prurit"],
      "gravite": "FAIBLE",
      "urgence": false,
      "conduite": "Repos, hydratation, paracétamol. Éviter AINS si dengue possible. Protection contre les piqûres (risque transmission sexuelle).",
      "delai_consultation": "Si suspicion grossesse",
      "particularite": "GRAVE chez la femme enceinte (microcéphalie fœtale). Transmission sexuelle possible (préservatif 6 mois)."
    },
    
    "Leptospirose": {
      "symptomes": ["fièvre_élevée", "frissons", "maux_de_tête_violents", "douleurs_musculaires", "conjonctivite", "ictère", "oligurie", "hémorragies", "myalgies_mollets"],
      "gravite": "ÉLEVÉE",
      "urgence": true,
      "conduite": "Hospitalisation. Doxycycline ou Pénicilline IV. Surveillance rénale (risque IRA).",
      "delai_consultation": "IMMÉDIAT",
      "traitement": {
        "premiere_ligne": "Pénicilline G IV 6M UI/jour 7 jours",
        "alternative": "Doxycycline 100mg ×2/jour 7 jours ou Ceftriaxone IV",
        "prophylaxie": "Doxycycline 200mg/semaine en zone à risque"
      }
    },
    
    "Choléra": {
      "symptomes": ["diarrhée_aqueuse_profuse", "vomissements", "déshydratation_sévère", "crampes_musculaires", "oligurie", "yeux_enfoncés", "pli_cutané", "choc_hypovolémique"],
      "gravite": "URGENCE_VITALE",
      "urgence": true,
      "conduite": "RÉHYDRATATION IMMÉDIATE (SRO ou IV Ringer Lactate). Antibiotiques : Doxycycline ou Azithromycine. Isolement.",
      "delai_consultation": "IMMÉDIAT",
      "traitement": {
        "rehydratation": "SRO (OMS) ou Ringer Lactate IV 100ml/kg en 3-6h",
        "antibiotiques": "Doxycycline 300mg dose unique (adulte) ou Azithromycine 1g dose unique",
        "zinc": "10-20mg/jour chez l'enfant (réduit durée diarrhée)"
      }
    },
    
    "Bilharziose": {
      "symptomes": ["hématurie", "douleurs_abdominales", "diarrhée_sanglante", "hépatomégalie", "splénomégalie", "fatigue_chronique", "anémie", "douleurs_miction"],
      "gravite": "MODÉRÉE",
      "urgence": false,
      "conduite": "Praziquantel 40mg/kg dose unique. Contrôle à 3 mois. Traitement de masse si communauté exposée.",
      "delai_consultation": "Programmé",
      "traitement": {
        "S_haematobium": "Praziquantel 40mg/kg dose unique",
        "S_mansoni": "Praziquantel 40mg/kg dose unique",
        "complications": "Surveiller fibrose hépatique, cancer vessie (S. haematobium)"
      }
    },
    
    "Trypanosomiase": {
      "symptomes": ["chancre_inoculation", "fièvre_irrégulière", "céphalées", "prurit", "adénopathies", "splénomégalie", "troubles_sommeil", "confusion", "tremblements", "ataxie"],
      "gravite": "URGENCE_VITALE",
      "urgence": true,
      "conduite": "Ponction lombaire + examen LCR. Traitement IV : Pentamidine ou Eflornithine selon stade. Hospitalisation.",
      "delai_consultation": "IMMÉDIAT",
      "stades": {
        "stade_1_lymphatique": "Pentamidine IM 4mg/kg/jour 7 jours",
        "stade_2_neurologique": "Eflornithine IV + Nifurtimox (NECT) 10 jours"
      }
    },
    
    "Leishmaniose_viscérale": {
      "symptomes": ["fièvre_prolongée", "splénomégalie_massive", "hépatomégalie", "pancytopénie", "amaigrissement", "fatigue_extrême", "pâleur", "adénopathies"],
      "gravite": "URGENCE_VITALE",
      "urgence": true,
      "conduite": "Test sérologique + parasitologie (ponction splénique/médullaire). Liposomal Amphotéricine B IV. Hospitalisation.",
      "delai_consultation": "IMMÉDIAT",
      "traitement": {
        "premiere_ligne": "Amphotéricine B liposomale IV 3mg/kg/jour J1-J5, J14, J21",
        "alternative": "Antimoniate de méglumine IM 20mg/kg/jour 28 jours"
      }
    },
    
    "Onchocercose": {
      "symptomes": ["prurit_intense", "lésions_cutanées", "nodules_sous_cutanés", "troubles_vision", "cécité_progressive", "dépigmentation", "lymphadénopathie"],
      "gravite": "MODÉRÉE",
      "urgence": false,
      "conduite": "Ivermectine 150µg/kg dose unique, répétée tous les 6-12 mois. Traitement de masse communautaire.",
      "delai_consultation": "Programmé",
      "traitement": {
        "antiparasitaire": "Ivermectine 150µg/kg (dose unique, renouvelée)",
        "contre_indication": "Co-infection Loa loa (risque encéphalopathie)"
      }
    },
    
    "Filariose_lymphatique": {
      "symptomes": ["lymphœdème", "éléphantiasis", "hydrocèle", "lymphangite", "fièvre", "frissons", "douleur_ganglionnaire", "œdème_membre"],
      "gravite": "MODÉRÉE",
      "urgence": false,
      "conduite": "Ivermectine + Albendazole (ou DEC + Albendazole) en dose unique annuelle. Soins locaux (hygiène, kinésithérapie).",
      "delai_consultation": "Programmé",
      "traitement": {
        "antiparasitaire": "Ivermectine 150µg/kg + Albendazole 400mg (dose unique annuelle)",
        "soins_locaux": "Lavage quotidien, surélévation, kinésithérapie décongestive"
      }
    }
  },
  
  "diagnostic_differentiel_tropical": {
    "fievre_aigue": [
      {"si": "fièvre + éruption + douleurs_rétro_orbitaires", "evoque": "Dengue"},
      {"si": "fièvre + arthralgies_symétriques", "evoque": "Chikungunya"},
      {"si": "fièvre + ictère + hémorragies", "evoque": "Fièvre jaune ou Leptospirose"},
      {"si": "fièvre + toux + expectorations", "evoque": "Pneumonie ou Typhoïde"},
      {"si": "fièvre + chancre + adénopathies", "evoque": "Trypanosomiase"},
      {"si": "fièvre_prolongée + splénomégalie + amaigrissement", "evoque": "Leishmaniose viscérale"}
    ],
    "fievre_hemorragique": [
      {"si": "fièvre + saignements + douleurs_abdominales", "evoque": "Dengue sévère"},
      {"si": "fièvre + ictère + hémorragies + insuffisance_rénale", "evoque": "Fièvre jaune ou Leptospirose"},
      {"si": "fièvre + diarrhée_sanglante + déshydratation", "evoque": "Choléra ou Shigellose"},
      {"si": "fièvre + hémorragies + choc", "evoque": "Sepsis ou Fièvre hémorragique virale"}
    ],
    "diarrhee_aigue": [
      {"si": "diarrhée_aqueuse_profuse + déshydratation_rapide", "evoque": "Choléra"},
      {"si": "diarrhée + fièvre + douleurs_abdominales", "evoque": "Typhoïde"},
      {"si": "diarrhée_sanglante + douleurs", "evoque": "Dysenterie bacillaire ou Amibiase"},
      {"si": "diarrhée_chronique + hépatomégalie", "evoque": "Bilharziose intestinale"}
    ]
  },
  
  "signes_urgence_tropicaux": [
    "Fièvre > 40°C ne répondant pas aux antipyrétiques",
    "Saignements actifs (gingivorragies, épistaxis, purpura)",
    "Choc (PAS < 90 mmHg, pouls filant, extrémités froides)",
    "Détresse respiratoire (FR > 30/min, SpO2 < 92%)",
    "Troubles de conscience (Glasgow < 13)",
    "Convulsions ou signes neurologiques focaux",
    "Ictère + fièvre (risque hépatite fulminante)",
    "Anurie (< 100ml/24h) ou oligurie",
    "Déshydratation sévère (pli cutané, yeux enfoncés, soif intense)",
    "Vomissements incoercibles empêchant toute hydratation orale"
  ]
}
