    "deployment_scripts": {
      "create_launch_template": "aws ec2 create-launch-template --launch-template-name qwen35-template --launch-template-data file://launch-template-data.json",
      "launch_instance": "aws ec2 run-instances --launch-template LaunchTemplateName=qwen35-template --count 1",
      "create_auto_scaling_group": "aws autoscaling create-auto-scaling-group --auto-scaling-group-name qwen35-asg --launch-template LaunchTemplateName=qwen35-template --min-size 2 --max-size 10 --desired-capacity 2 --vpc-zone-identifier subnet-xxx,subnet-yyy"
    }
