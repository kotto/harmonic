    "best_practices": {
      "security": [
        "Utiliser des groupes de sécurité avec des règles minimales",
        "Restreindre l'accès SSH aux IPs autorisées uniquement",
        "Activer les logs VPC Flow Logs",
        "Utiliser des rôles IAM au lieu de credentials statiques",
        "Chiffrer les volumes EBS avec KMS"
      ],
      "performance": [
        "Utiliser des instances GPU (g5) pour l'inférence LLM",
        "Configurer le stockage gp3 avec IOPS adaptés",
        "Mettre en cache les modèles en mémoire GPU",
        "Utiliser le batching pour optimiser l'utilisation GPU",
        "Surveiller l'utilisation GPU avec nvtop"
      ],
      "cost_optimization": [
        "Utiliser des instances Spot pour les charges non critiques",
        "Arrêter les instances de développement hors heures de travail",
        "Configurer des politiques d'auto-scaling",
        "Surveiller les coûts avec AWS Cost Explorer",
        "Utiliser des réservations pour les instances de production"
      ],
      "monitoring": [
        "Activer CloudWatch detailed monitoring",
        "Configurer des dashboards pour les métriques GPU",
        "Mettre en place des alertes pour les seuils critiques",
        "Loguer les requêtes API pour le débogage",
        "Surveiller la latence des réponses API"
      ]
