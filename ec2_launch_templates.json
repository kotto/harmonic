    "launch_configurations": {
      "development_launch": {
        "template_name": "development",
        "region": "us-east-1",
        "min_count": 1,
        "max_count": 1,
        "subnet_id": "",
        "enable_public_ip": true,
        "monitoring": {
          "enabled": true,
          "detailed": false
        },
        "tags": [
          {"Key": "Name", "Value": "qwen35-dev-instance"},
          {"Key": "Environment", "Value": "Development"},
          {"Key": "Project", "Value": "Harmonic-AI"},
          {"Key": "ManagedBy", "Value": "Terraform/Ansible"}
        ]
      },
      
      "production_launch": {
        "template_name": "production_medium",
        "region": "us-east-1",
        "min_count": 2,
        "max_count": 2,
        "subnet_id": "",
        "enable_public_ip": true,
        "monitoring": {
          "enabled": true,
          "detailed": true
        },
        "load_balancer": {
          "enabled": true,
          "type": "application",
          "health_check_path": "/health"
        },
        "auto_scaling": {
          "enabled": true,
          "min_size": 2,
          "max_size": 10,
          "desired_capacity": 2,
          "scaling_policies": [
            {
              "metric": "CPUUtilization",
              "threshold": 70,
              "adjustment": "+1"
            },
            {
              "metric": "CPUUtilization",
              "threshold": 30,
              "adjustment": "-1"
            }
          ]
        },
        "tags": [
          {"Key": "Name", "Value": "qwen35-prod-instance"},
          {"Key": "Environment", "Value": "Production"},
          {"Key": "Project", "Value": "Harmonic-AI"},
          {"Key": "ManagedBy", "Value": "Terraform/Ansible"},
          {"Key": "CostCenter", "Value": "AI-Research"}
        ]
      }
