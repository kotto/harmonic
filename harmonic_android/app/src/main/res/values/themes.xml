<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HarmonicAI" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/harmonic_primary</item>
        <item name="colorPrimaryDark">@color/harmonic_primary_dark</item>
        <item name="colorAccent">@color/harmonic_accent</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/harmonic_primary_dark</item>
        
        <!-- Background -->
        <item name="android:windowBackground">@color/harmonic_bg</item>
        
        <!-- Button style -->
        <item name="materialButtonStyle">@style/Widget.MaterialComponents.Button</item>
        
        <!-- Card style -->
        <item name="materialCardViewStyle">@style/Widget.MaterialComponents.CardView</item>
    </style>
</resources>