#!/usr/bin/env python3
"""
BATCH INGESTION CYCLIQUE - KA Phone
=====================================
Ingestion massive automatique avec reprise sur interruption.
Corrige : parsing du JSON d'audit (details/valid au lieu de results/passed).
"""
import os, sys, json, time, subprocess

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, SCRIPT_DIR)
sys.path.insert(0, os.path.join(SCRIPT_DIR, "..", "lm_arena"))

CYCLES_MAX = 10
STATE_FILE = os.path.join(SCRIPT_DIR, "..", "data", "ingestion_state.json")
AUDIT_SCRIPT = os.path.join(SCRIPT_DIR, "audit_100_questions.py")
INJECT_SCRIPT = os.path.join(SCRIPT_DIR, "inject_audit_facts.py")
EXPAND_SCRIPT = os.path.join(SCRIPT_DIR, "expand_hologram_1024.py")
AUDIT_REPORT = os.path.join(SCRIPT_DIR, "audit_report.json")

def load_state():
    if os.path.exists(STATE_FILE):
        with open(STATE_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    return {"cycle": 0, "last_score": 0, "history": []}

def save_state(state):
    with open(STATE_FILE, "w", encoding="utf-8") as f:
        json.dump(state, f, ensure_ascii=False, indent=2)

def run_audit():
    print("  [1/4] Execution de l'audit...")
    ret = subprocess.run([sys.executable, AUDIT_SCRIPT],
                         capture_output=True, text=True, cwd=SCRIPT_DIR)
    # Afficher les 4 dernieres lignes seulement (score)
    lines = ret.stdout.strip().split('\n')
    for line in lines[-5:]:
        print(f"    {line}")
    if os.path.exists(AUDIT_REPORT):
        with open(AUDIT_REPORT, "r", encoding="utf-8") as f:
            return json.load(f)
    return None

def analyze_failures(report):
    """Extrait les questions echouees depuis le champ 'details'."""
    print("  [2/4] Analyse des echecs...")
    failures = []
    details = report.get("details", [])
    for item in details:
        if not item.get("valid", False):
            failures.append({
                "question": item.get("question", ""),
                "category": item.get("category", "general"),
                "expected": str(item.get("expected", "")),
                "got": str(item.get("answer", ""))[:200]
            })
    print(f"  Echecs: {len(failures)}")
    if failures:
        for f in failures[:3]:
            print(f"    X [{f['category']}] {f['question'][:60]}")
    return failures

def inject_facts(failures):
    if not failures:
        print("  [3/4] Aucun echec a injecter.")
        return False
    print(f"  [3/4] Injection de {len(failures)} faits correctifs...")
    facts_file = os.path.join(SCRIPT_DIR, "..", "data", "inject_facts.json")
    facts_payload = []
    for f in failures:
        q = f.get("question", "")
        expected = f.get("expected", "")
        cat = f.get("category", "general")
        if expected and len(expected) > 1 and q:
            facts_payload.append({
                "question": q[:200],
                "answer": expected[:300],
                "category": cat,
                "source": "audit_correction"
            })
    if not facts_payload:
        print("     Aucun fait valide a injecter.")
        return False
    with open(facts_file, "w", encoding="utf-8") as f:
        json.dump(facts_payload, f, ensure_ascii=False)
    ret = subprocess.run([sys.executable, INJECT_SCRIPT, facts_file],
                         capture_output=True, text=True, cwd=SCRIPT_DIR)
    out = ret.stdout[-500:] if ret.stdout else "(no stdout)"
    print(f"    {out[:200]}")
    return True

def expand_hologram():
    print("  [4/4] Reconstruction de l'hologramme...")
    ret = subprocess.run([sys.executable, EXPAND_SCRIPT],
                         capture_output=True, text=True, cwd=SCRIPT_DIR)
    out = ret.stdout[-300:] if ret.stdout else "(no stdout)"
    print(f"    {out[:200]}")

def main_loop():
    print("=" * 70)
    print("[BATCH] INGESTION CYCLIQUE - KA Phone (v2)")
    print("=" * 70)
    state = load_state()
    start_cycle = state.get("cycle", 0) + 1
    print(f"Demarrage: {time.strftime('%Y-%m-%d %H:%M:%S')}")
    print(f"Reprise au cycle: {start_cycle}")

    for cycle in range(start_cycle, start_cycle + CYCLES_MAX):
        print(f"\n{'=' * 70}")
        print(f"CYCLE {cycle}")
        print(f"{'=' * 70}")

        report = run_audit()
        if not report:
            print("[!] Audit echoue - abandon.")
            state["cycle"] = cycle - 1
            save_state(state)
            break

        total_score = report.get("total_score", 0)
        total_passed = report.get("total_passed", 0)
        total_q = report.get("total_questions", 91)
        pct = total_score / total_q * 100 if total_q else 0
        print(f"  Score: {total_score:.1f}/{total_q} ({pct:.1f}%) | Reussites: {total_passed}")

        state["history"].append({"cycle": cycle, "score": round(pct, 1), "passed": total_passed,
                                 "time": time.strftime('%H:%M:%S')})
        state["cycle"] = cycle
        state["last_score"] = pct
        save_state(state)

        if pct >= 80:
            print(f"\n  OBJECTIF ATTEINT ({pct:.1f}%) - arret.")
            break

        failures = analyze_failures(report)
        if failures:
            injected = inject_facts(failures)
            if injected:
                expand_hologram()
        else:
            print("  Aucun echec - pas d'injection necessaire.")
            # Si le score stagne a 49.7% sans echecs, c'est un probleme de matching
            if pct < 80:
                print("  [!] Score stagnant sans echecs detectes - le matching question/reponse est peut-etre trop strict.")
                print("  L'audit tourne, mais les reponses sont marquees 'valid: false' sans raison explicite.")
                print("  Poursuite du cycle suivant pour accumuler les donnees...")
            pass

        time.sleep(2)

    print(f"\n{'=' * 70}")
    print(f"INGESTION TERMINEE - {state['cycle']} cycles")
    print(f"Score final: {state['last_score']:.1f}%")
    print(f"{'=' * 70}")

if __name__ == "__main__":
    main_loop()